# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real secrets.

domain            = "yourdomain.com"
db_password       = "generate-with-openssl-rand-hex-32"  # openssl rand -hex 32
jwt_secret        = "generate-with-openssl-rand-hex-32"  # openssl rand -hex 32
proxy_token       = "generate-with-openssl-rand-hex-32"  # openssl rand -hex 32
anthropic_api_key = ""        # optional — leave empty to disable Claude analysis
image_tag         = "1.3.0"   # check https://github.com/Cipher-OSS/cipher-shield/releases

# First-run bootstrap — server creates this admin on startup when no users exist.
# Remove admin_password from this file after confirming the account is created.
admin_email    = "admin@yourcompany.com"
admin_password = ""  # openssl rand -hex 12

# Optional overrides (defaults shown)
# location        = "East US 2"
# shield_mode     = "enforce"   # enforce | warn — use warn for initial rollouts
# api_max_count   = 10          # max API container replicas
# proxy_max_count = 10          # max proxy container replicas
